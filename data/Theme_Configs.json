{
    "Format_Rules": [
        {
            "themes": ["YWMD", "JTDT", "JJGQ", "XTJX", "QLJX", "SXDT", "HAJH", "Module", "CQ", "KJMD"],
            "types": ["Start", "End", "Area", "Outer"],
            "format": "NxN_Tile"
        },
        {
            "themes": ["Module"],
            "types": ["Items"],
            "format": "NxN_Tile"
        },
        {
            "themes": ["XXGCB"],
            "types": ["Room"],
            "format": "Room_XXGCB"
        }
    ],
    "Asset_Name_Formats": {
        "NxN_Tile": {
            "delimiter": "_",
            "fields": ["", "Theme_Name", "Tile_Type", "Area_Level", "Size", "Opening", "Art_Variant", ""],
            "post_parse": [
                {
                    "hook": "split_size",
                    "args": {
                        "source": "Size",
                        "prefix": "Size"
                    }
                }
            ]
        },
        "Room_XXGCB": {
            "delimiter": "_",
            "fields": ["", "Theme_Name", "", "Room_Size", "Room_Type_Str", "CTG_Number", "Room_Variant_Number", ""],
            "post_parse": [
                {
                    "hook": "split_size",
                    "args": {
                        "source": "Room_Size",
                        "prefix": "Room_Size"
                    }
                },
                {
                    "hook": "map_string_to_id",
                    "args": {
                        "source": "Room_Type_Str",
                        "id_attr": "Room_Type_ID",
                        "values": ["Living", "Bed", "Book", "Storage"]
                    }
                }
            ]
        }
    },
