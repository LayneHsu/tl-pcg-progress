    { "from": "stage2_2.placement_table",          "to": "stage2_4.placement_table_export",      "type": "must_complete" },
    { "from": "stage2_2.collision_excluded_table", "to": "stage2_4.collision_excluded_export",   "type": "must_complete" },
    { "from": "stage2_2.nav_ground_table",         "to": "stage2_4.nav_ground_export",           "type": "must_complete" },
    { "from": "stage2_2.assets_groups_csv",        "to": "stage2_4.assets_groups_export",        "type": "must_complete", "reason": "实际是同一文件，确认到位" },

    { "from": "stage2_4.sm_fbx",                   "to": "stage2_5.fbx_to_geo", "type": "must_complete" },
    { "from": "stage2_4.bpsm_fbx",                 "to": "stage2_5.fbx_to_geo", "type": "must_complete" },
    { "from": "stage2_4.dynamic_wall_bpsm_fbx",    "to": "stage2_5.fbx_to_geo", "type": "must_complete" },
    { "from": "stage2_4.white_box_sm_fbx",         "to": "stage2_5.fbx_to_geo", "type": "must_complete" },
    { "from": "stage2_4.black_box_sm_fbx",         "to": "stage2_5.fbx_to_geo", "type": "must_complete" },
    { "from": "stage2_4.collision_sm_fbx",         "to": "stage2_5.fbx_to_geo", "type": "must_complete" },

    { "from": "stage2_4.placement_table_export",   "to": "stage3_2.module_adapt",       "type": "must_complete", "reason": "Houdini 端读 JSON 做配置" },
    { "from": "stage2_4.collision_excluded_export","to": "stage3_2.collision_bp_adapt", "type": "must_complete" },
    { "from": "stage2_4.nav_ground_export",        "to": "stage3_2.nav_ground_adapt",   "type": "must_complete" },
    { "from": "stage2_5.fbx_to_geo",               "to": "stage3_2",                    "type": "must_complete", "reason": "生成功能适配需要主题 GEO 文件" },

    { "from": "stage2_1.tile_size",  "to": "stage3_1.tile_size_adapt",  "type": "must_complete" },
    { "from": "stage2_1.road_width", "to": "stage3_1.road_width_adapt", "type": "must_complete" },

    { "from": "stage3_1", "to": "stage3_2",            "type": "soft", "reason": "通常布局先做但可并行" },
    { "from": "stage3_1", "to": "stage4.hda_version_update", "type": "must_complete" },
    { "from": "stage3_2", "to": "stage4.hda_version_update", "type": "must_complete", "reason": "适配完成后 HDA 才能升级" },

    { "from": "stage1.env_bp", "to": "stage4.theme_env_sphere_config", "type": "must_complete" },
    { "from": "stage1.env_bp", "to": "stage4.theme_lighting_config",   "type": "must_complete" },

    { "from": "stage4.hda_version_update",    "to": "stage5.level_folder_gen",      "type": "must_complete", "reason": "PCG Pipeline 跑前必须用最新 HDA" },
    { "from": "stage4.hda_version_update",    "to": "stage5.work_level",            "type": "must_complete" },
    { "from": "stage4.hda_version_update",    "to": "stage5.sequence_level",        "type": "must_complete" },
    { "from": "stage4.hda_version_update",    "to": "stage5.art_asset_placement",   "type": "must_complete" },
    { "from": "stage4.hda_version_update",    "to": "stage5.env_lighting_placement","type": "must_complete" },
    { "from": "stage4.theme_lighting_config", "to": "stage5.env_lighting_placement","type": "must_complete", "reason": "postprocess_items 必须先填" },
    { "from": "stage4.theme_env_sphere_config","to": "stage5.env_lighting_placement","type": "must_complete", "reason": "环境球资产必须就绪" },

    { "from": "stage5.level_folder_gen", "to": "stage5.work_level",           "type": "must_complete", "reason": "PCG Pipeline Step1→Step2" },
    { "from": "stage5.work_level",       "to": "stage5.sequence_level",       "type": "must_complete", "reason": "Step2→Step2.1 Duplicate to Landscape" },
    { "from": "stage5.work_level",       "to": "stage5.art_asset_placement",  "type": "must_complete", "reason": "美术资产由 HDA 在 work 关卡放置" },
    { "from": "stage5.sequence_level",   "to": "stage5.env_lighting_placement","type": "must_complete", "reason": "Step3 Postprocess 在子关卡注入 BP_Env" },

    { "from": "stage1.extra_bp.dynamic_wall_bp",       "to": "stage1.extra_bp.dynamic_wall_bp_white", "type": "must_complete", "reason": "动态墙 BP 与对应白模配对生产" },
    { "from": "stage2_3.distant_bp_to_sm",             "to": "stage2_4.bpsm_fbx",                     "type": "must_complete", "reason": "远景转 SM 后混入 bpsm 桶导出" },

    { "from": "stage1.modules",                        "to": "stage2_4.sm_fbx",                       "type": "soft", "reason": "美术原始零件 SM 也可独立导出 FBX（与 bpsm 区分）" }
  ]
}
